# Copy this file to .env and fill in real values. Never commit the real .env.

# Required: Foundry project endpoint and model deployment (see azure.yaml)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Optional: URLs of connected agents reached over A2A. Any left unset makes
# that connected agent unavailable (a warning is logged, not an error).
FAQ_AGENT_URL=
ORDER_AGENT_URL=
PANDA_AGENT_URL=
SHIPPING_REFUND_AGENT_URL=
